# Copy this file to .env, then replace every placeholder with your own values.
# Never commit .env: it contains your Home Assistant token and site configuration.

# Home Assistant settings. Create a dedicated long-lived token.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
POWERDOWN_CONTROLLER_VERSION=v0.4.0
# Find this in the Teslemetry integration URL: /config/integrations/integration/<ID>
TESLEMETRY_CONFIG_ENTRY_ID=YOUR_TESLEMETRY_CONFIG_ENTRY_ID
TESLEMETRY_DEVICE_ID=YOUR_POWERWALL_HOME_ASSISTANT_DEVICE_ID

# Home Assistant entity IDs.
POWER_DOWN_CALENDAR=calendar.your_octopus_power_down
OPERATION_MODE_ENTITY=select.your_powerwall_operation_mode

# Direct Myenergi cloud API credentials. Use an API key generated in Myenergi,
# not the credentials from a Home Assistant integration export.
MYENERGI_USERNAME=YOUR_MYENERGI_SERIAL_NUMBER
MYENERGI_PASSWORD=YOUR_MYENERGI_API_KEY
# Myenergi grid power is normally positive for import and negative for export.
MYENERGI_EXPORT_SIGN=-1
MYENERGI_POLL_SECONDS=5

# Restores at 0.85 kWh to leave latency margin below the 1 kWh maximum.
EXPORT_TARGET_KWH=0.85
MAX_EXPORT_SECONDS=420
ACTIVE_POLL_SECONDS=2
IDLE_POLL_SECONDS=60
EXPORT_RATE_PERIOD=PARTIAL_PEAK
TEMPORARY_SELL_RATE=3
